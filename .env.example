# Public Vite env (safe to commit placeholders)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Hosted Lovable projects may use https://YOUR_PROJECT.lovable.cloud
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# Edge function secrets (set in Supabase dashboard / CLI — never commit real values)
# DEMO_SETUP_SECRET=long-random-secret
# DEMO_USER_ID=uuid-of-demo-user
# LOVABLE_API_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
# SUPABASE_ANON_KEY=...

# Optional independent AI provider (Supabase secrets only, never VITE_ variables).
# Set all three to use a Chat Completions-compatible vision provider.
# AI_API_URL=https://YOUR_PROVIDER/v1/chat/completions
# AI_API_KEY=...
# AI_MODEL=provider-vision-model-id
# AI_VIDEO_MODEL=provider-video-model-id  # only if provider supports video_url
# APP_ALLOWED_ORIGINS=https://your-production-host.example
# With no AI_* configuration, existing LOVABLE_API_KEY remains supported.

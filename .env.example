# Public Vite env (safe to commit placeholders)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Hosted Lovable projects may use https://YOUR_PROJECT.lovable.cloud
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# Edge function secrets (set in Supabase dashboard / CLI — never commit real values)
# DEMO_SETUP_SECRET=long-random-secret
# DEMO_USER_ID=uuid-of-demo-user
# LOVABLE_API_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
# SUPABASE_ANON_KEY=...
